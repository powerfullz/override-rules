{
  "name": "override-rules",
  "private": true,
  "version": "2.10.1",
  "description": "Override rules YAML generator",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "typecheck": "node node_modules/typescript-native/bin/tsc --noEmit",
    "build": "npm run typecheck && node scripts/build.mjs",
    "generate": "tsx scripts/yaml_generator/generator.ts",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "artifacts": "npm run build && npm run generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:cov": "c8 --all --include 'src/**/*.ts' --include 'scripts/yaml_generator/**/*.ts' --reporter=text --reporter=text-summary --reporter=html node --import tsx --test \"tests/**/*.test.ts\"",
    "audit": "npm audit --omit=dev",
    "prepare": "husky",
    "preversion": "npm run lint && npm run typecheck",
    "version": "node scripts/changelog.mjs && git add CHANGELOG.md",
    "postversion": "git push --follow-tags"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.2.2",
    "git-cliff": "^2.13.1",
    "husky": "^9.1.7",
    "knip": "^6.44.2",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.7",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "typescript-native": "npm:typescript@^7.0.2"
  },
  "lint-staged": {
    "*.{ts,js,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
